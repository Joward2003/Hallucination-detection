# 本机配置；服务自动读取，禁止提交真实 Key，不必 source .env。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_WIRE_API=responses
LLM_STREAM=false
LLM_HTTP_HEADERS={}
LLM_STRUCTURED_OUTPUT=false
LLM_TIMEOUT=60
LLM_RETRIES=1
LLM_MAX_TOKENS=8192

# 本地真实中文模型。启动默认离线加载已缓存的权重。
CREDIT_REVIEW_RETRIEVAL_BACKEND=sentence_transformers
CREDIT_REVIEW_EMBEDDING_MODEL=moka-ai/m3e-base
CREDIT_REVIEW_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 模型未准备好时，可明确使用 lexical（BM25），界面会标明；不会伪装向量检索。
